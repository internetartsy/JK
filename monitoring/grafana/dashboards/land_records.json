{
    "annotations": {
        "list": []
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "panels": [
        {
            "title": "OCR Metrics",
            "type": "row",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "title": "OCR Request Rate",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 1
            },
            "targets": [
                {
                    "expr": "rate(ocr_requests_total[5m])",
                    "legendFormat": "Requests/sec"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "OCR Success Rate",
            "type": "gauge",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 1
            },
            "targets": [
                {
                    "expr": "1 - (rate(ocr_requests_failed_total[5m]) / rate(ocr_requests_total[5m]))",
                    "legendFormat": "Success Rate"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "min": 0,
                    "max": 1,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.9
                            },
                            {
                                "color": "green",
                                "value": 0.95
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "OCR Latency (p95)",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 1
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, rate(ocr_request_duration_seconds_bucket[5m]))",
                    "legendFormat": "p95 Latency"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 10
                            },
                            {
                                "color": "red",
                                "value": 30
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Avg Confidence Score",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 1
            },
            "targets": [
                {
                    "expr": "avg(extraction_confidence_score)",
                    "legendFormat": "Avg Confidence"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.7
                            },
                            {
                                "color": "green",
                                "value": 0.85
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Review Task Metrics",
            "type": "row",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 5
            }
        },
        {
            "title": "Review Tasks by Priority",
            "type": "piechart",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 0,
                "y": 6
            },
            "targets": [
                {
                    "expr": "sum by (priority) (review_tasks_pending_total)",
                    "legendFormat": "{{priority}}"
                }
            ]
        },
        {
            "title": "Pending Review Tasks",
            "type": "stat",
            "gridPos": {
                "h": 3,
                "w": 4,
                "x": 8,
                "y": 6
            },
            "targets": [
                {
                    "expr": "review_tasks_pending_total",
                    "legendFormat": "Pending"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 20
                            },
                            {
                                "color": "red",
                                "value": 50
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Completed Today",
            "type": "stat",
            "gridPos": {
                "h": 3,
                "w": 4,
                "x": 12,
                "y": 6
            },
            "targets": [
                {
                    "expr": "increase(review_tasks_completed_total[24h])",
                    "legendFormat": "Completed"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Review Task Trend",
            "type": "timeseries",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 16,
                "y": 6
            },
            "targets": [
                {
                    "expr": "review_tasks_pending_total",
                    "legendFormat": "Pending"
                },
                {
                    "expr": "increase(review_tasks_completed_total[1h])",
                    "legendFormat": "Completed/hr"
                }
            ]
        },
        {
            "title": "Sync Metrics",
            "type": "row",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 12
            }
        },
        {
            "title": "Sync Operations",
            "type": "timeseries",
            "gridPos": {
                "h": 6,
                "w": 12,
                "x": 0,
                "y": 13
            },
            "targets": [
                {
                    "expr": "rate(sync_operations_total[5m])",
                    "legendFormat": "Total"
                },
                {
                    "expr": "rate(sync_operations_failed_total[5m])",
                    "legendFormat": "Failed"
                }
            ]
        },
        {
            "title": "Sync Queue Size",
            "type": "stat",
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 12,
                "y": 13
            },
            "targets": [
                {
                    "expr": "sync_queue_pending_items",
                    "legendFormat": "Pending Items"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 50
                            },
                            {
                                "color": "red",
                                "value": 100
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Conflict Rate",
            "type": "gauge",
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 18,
                "y": 13
            },
            "targets": [
                {
                    "expr": "rate(sync_conflicts_total[1h]) / rate(sync_operations_total[1h])",
                    "legendFormat": "Conflict Rate"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "min": 0,
                    "max": 0.2,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.05
                            },
                            {
                                "color": "red",
                                "value": 0.1
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "System Health",
            "type": "row",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 19
            }
        },
        {
            "title": "API Response Time",
            "type": "timeseries",
            "gridPos": {
                "h": 6,
                "w": 12,
                "x": 0,
                "y": 20
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket[5m]))",
                    "legendFormat": "p50"
                },
                {
                    "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
                    "legendFormat": "p95"
                },
                {
                    "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
                    "legendFormat": "p99"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                }
            }
        },
        {
            "title": "Memory Usage",
            "type": "timeseries",
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 12,
                "y": 20
            },
            "targets": [
                {
                    "expr": "process_resident_memory_bytes / 1024 / 1024",
                    "legendFormat": "Memory (MB)"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "decmbytes"
                }
            }
        },
        {
            "title": "Active Connections",
            "type": "stat",
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 18,
                "y": 20
            },
            "targets": [
                {
                    "expr": "db_pool_in_use_connections",
                    "legendFormat": "DB Connections"
                }
            ]
        }
    ],
    "refresh": "10s",
    "schemaVersion": 38,
    "tags": [
        "land-records",
        "ocr",
        "monitoring"
    ],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "timepicker": {},
    "timezone": "browser",
    "title": "Land Records OCR Dashboard",
    "uid": "land-records-main",
