# Land Records Platform - Environment Configuration
# Copy this file to .env and adjust as necessary for your deployment.

# ==========================================
# 1. Deployment Mode (Dev / Prod)
# ==========================================
# Set to 'backend' to run the backend in Docker. Leave empty to run backend locally on host.
# COMPOSE_PROFILES=backend 

# ==========================================
# 2. Service URLs (Connecting the pieces)
# ==========================================
# Where is the Backend API running?
# Local Development (Host Machine): http://host.docker.internal:8000
# Docker Internal: http://backend:8000
# External Cloud: https://api.yourdomain.com
BACKEND_URL=http://host.docker.internal:8000

# Where is the Frontend running?
FRONTEND_URL=http://frontend:5173

# Where is Frappe / ERPNext running?
FRAPPE_URL=http://erp-web:8000

# ==========================================
# 3. Security & Secrets (CHANGE THESE IN PROD)
# ==========================================
JWT_SECRET=supersecretjwt
ENCRYPTION_KEY=supersecretkey
DB_PASSWORD=password
GRAFANA_PASSWORD=admin
ERP_DB_PASSWORD=admin

# ==========================================
# 4. External Services (If self-hosting separately)
# ==========================================
# If using managed Postgres/Redis, update these:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# REDIS_URL=redis://host:6379
